{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "P12 Librarian",
  "version": "0.6.0",
  "identifier": "app.p12librarian",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "sh ../licenses/generate.sh && npm run build && cargo build --release -p p12-cli"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "P12 Librarian",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "license": "LicenseRef-P12-Librarian-Freeware",
    "licenseFile": "../../LICENSE",
    "resources": [
      "resources/user-guide.pdf"
    ],
    "publisher": "Qutrit",
    "copyright": "Copyright (c) 2026 Qutrit. Freeware, see LICENSE.",
    "category": "Music",
    "homepage": "https://qutrit.se/p12-librarian/",
    "shortDescription": "Patch librarian for the Sequential Prophet 12",
    "longDescription": "Back up, browse, search, rename and restore the programs of a Dave Smith Instruments Prophet 12 over MIDI SysEx, with automatic backups and verification of every write. Includes the p12 command-line tool.",
    "linux": {
      "deb": {
        "depends": [
          "libasound2t64 | libasound2"
        ],
        "section": "sound",
        "conflicts": ["dsi-prophet-12-librarian", "dsi-prophet-12-patch-librarian"],
        "replaces": ["dsi-prophet-12-librarian", "dsi-prophet-12-patch-librarian"],
        "files": {
          "/usr/bin/p12": "../../target/release/p12",
          "/usr/share/doc/p12-librarian/LICENSE": "../../LICENSE",
          "/usr/share/doc/p12-librarian/DISCLAIMER.md": "../../DISCLAIMER.md",
          "/usr/share/doc/p12-librarian/licenses/rust.md": "../../licenses/rust.md",
          "/usr/share/doc/p12-librarian/licenses/javascript.md": "../../licenses/javascript.md",
          "/usr/share/doc/p12-librarian/THIRD-PARTY-NOTICES.md": "../../THIRD-PARTY-NOTICES.md",
          "/usr/share/doc/p12-librarian/fonts/JetBrainsMono-OFL.txt": "../src/assets/fonts/jetbrains-mono/OFL.txt",
          "/usr/share/doc/p12-librarian/fonts/Hack-LICENSE.md": "../src/assets/fonts/hack/LICENSE.md",
          "/usr/share/doc/p12-librarian/fonts/FiraCode-OFL.txt": "../node_modules/@fontsource/fira-code/LICENSE"
        }
      }
    }
  }
}
